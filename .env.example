# RoadVision Configuration & Environment Variables

# Runtime storage directory (SQLite database, temporary uploads, outputs, logs)
# Defaults to <project_root>/data if omitted
ROADVISION_DATA_DIR=data

# Hardware compute device preference
# Options: 'cpu', 'cuda:0', '0' (will automatically resolve to cuda:0 if NVIDIA GPU is present, else cpu)
ROADVISION_DEVICE=

# Optional model weight checkpoint path override
# Defaults to <project_root>/models/weights/yolo26m.pt
ROADVISION_MODEL_PATH=

# FastAPI Server Host and Port
ROADVISION_HOST=127.0.0.1
ROADVISION_PORT=8000

# Frontend development server API proxy target
VITE_API_URL=http://127.0.0.1:8000

